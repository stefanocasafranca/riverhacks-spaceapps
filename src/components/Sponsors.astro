---
import Section from './Section.astro';
import { SPONSORS, SUPPORTERS } from '../data/event';
---

<Section
  chapter="mars"
  id="sponsor"
  eyebrow="Thank you"
  title="Sponsors"
  accent="violet"
  wide
>
  <p class="-mt-6 mb-10 max-w-2xl text-[0.975rem] leading-relaxed text-ink-2 sm:text-lg">
    RiverHacks 2026 is made possible by these partners.
  </p>

  <!-- Secured sponsors. Title is the largest mark on the page section,
       Platinum next, then Gold, then the smaller tiers. Logo files are
       served locally from /public/brand. -->
  <div class="mb-4 grid gap-4">
    <a
      href={SPONSORS.title.url}
      target="_blank"
      rel="noopener"
      class="panel group relative block overflow-hidden rounded-3xl border-white/30 px-6 py-10 text-center transition hover:border-cyan/60 sm:px-10 sm:py-14"
    >
      <div aria-hidden="true" class="pointer-events-none absolute -top-24 left-1/2 h-56 w-72 -translate-x-1/2 rounded-full bg-cyan/15 blur-3xl"></div>
      <p class="eyebrow relative text-cyan">{SPONSORS.title.tier}</p>
      <img
        src={SPONSORS.title.logo}
        alt={SPONSORS.title.name}
        width={SPONSORS.title.width}
        height={SPONSORS.title.height}
        loading="lazy"
        decoding="async"
        class="relative mx-auto mt-6 h-auto w-[min(78%,26rem)]"
      />
      <p class="relative mt-6 text-[0.9375rem] text-ink-2 sm:text-base">
        {SPONSORS.title.credit}
      </p>
    </a>

    <a
      href={SPONSORS.platinum.url}
      target="_blank"
      rel="noopener"
      class="panel group relative block overflow-hidden rounded-3xl border-violet/45 px-6 py-8 text-center transition hover:border-violet sm:px-10 sm:py-10"
    >
      <div aria-hidden="true" class="pointer-events-none absolute -top-20 left-1/2 h-44 w-60 -translate-x-1/2 rounded-full bg-violet/20 blur-3xl"></div>
      <p class="eyebrow relative text-violet">{SPONSORS.platinum.tier}</p>
      <img
        src={SPONSORS.platinum.logo}
        alt={SPONSORS.platinum.name}
        width={SPONSORS.platinum.width}
        height={SPONSORS.platinum.height}
        loading="lazy"
        decoding="async"
        class="relative mx-auto mt-5 h-auto w-[min(70%,18rem)]"
      />
    </a>

    <a
      href={SPONSORS.gold.url}
      target="_blank"
      rel="noopener"
      class="panel group relative block overflow-hidden rounded-3xl border-gold/35 px-6 py-7 text-center transition hover:border-gold sm:px-10 sm:py-9"
    >
      <div aria-hidden="true" class="pointer-events-none absolute -top-20 left-1/2 h-40 w-56 -translate-x-1/2 rounded-full bg-gold/15 blur-3xl"></div>
      <p class="eyebrow relative text-gold">{SPONSORS.gold.tier}</p>
      <div class="relative mt-5 flex items-center justify-center gap-3">
        <img
          src={SPONSORS.gold.logo}
          alt=""
          width={SPONSORS.gold.width}
          height={SPONSORS.gold.height}
          loading="lazy"
          decoding="async"
          class="h-12 w-12 sm:h-14 sm:w-14"
        />
        <span class="display text-[clamp(1.25rem,5.5vw,1.75rem)] text-ink">{SPONSORS.gold.name}</span>
      </div>
    </a>
  </div>

  <!-- Smaller tiers: one tile each, logo on a neutral plate. -->
  <ul class="grid gap-4 sm:grid-cols-3">
    {
      SUPPORTERS.map((s) => {
        const Tag = s.url ? 'a' : 'div';
        return (
          <li>
            <Tag
              {...(s.url ? { href: s.url, target: '_blank', rel: 'noopener' } : {})}
              class="panel flex h-full flex-col items-center rounded-3xl border-white/20 px-6 py-6 text-center transition hover:border-white/50"
            >
              <p class="eyebrow text-ink-2">{s.tier}</p>
              <div class="mt-4 flex h-20 w-full items-center justify-center">
                <img
                  src={s.logo}
                  alt={s.name}
                  width={s.width}
                  height={s.height}
                  loading="lazy"
                  decoding="async"
                  class:list={[s.width / s.height > 2 ? 'h-9' : 'h-16', 'w-auto max-w-full object-contain']}
                />
              </div>
            </Tag>
          </li>
        );
      })
    }
  </ul>
</Section>
