---
import { ORIENTATION } from '../data/event';

// Top-of-page notice for the moved guardian orientation. Rendered on home and
// /legal. Copy lives in event.ts; this file is layout only.
interface Props {
  class?: string;
}
const { class: extra } = Astro.props;
const when = ORIENTATION.time ? `${ORIENTATION.date}, ${ORIENTATION.time}` : ORIENTATION.date;
---

<section
  id="orientation-notice"
  aria-labelledby="orientation-notice-h"
  class:list={['relative z-10 rounded-3xl border-2 border-gold bg-space-2 p-6 sm:p-9', extra]}
>
  <p class="eyebrow text-gold">
    <span aria-hidden="true" class="mr-1.5">&#9888;</span>Date changed · Under 18 only
  </p>
  <h2 id="orientation-notice-h" class="display mt-3 text-[clamp(1.75rem,7.5vw,3rem)] text-ink">
    Guardian orientation is now on <span class="text-gold">{ORIENTATION.date}</span>
  </h2>
  <p class="mt-4 text-[1rem] leading-relaxed text-ink-2 sm:text-lg">
    {!ORIENTATION.time && <strong class="font-semibold text-ink">{ORIENTATION.timeTba}.</strong>}{' '}
    It replaces the October 16 and 17 sessions. Every participant under 18 needs a parent or
    guardian to attend. It is required to participate.
  </p>
  <p class="mt-4 text-[1.0625rem] font-semibold leading-snug text-gold sm:text-xl">
    {ORIENTATION.formLine}
  </p>
  <a
    href={ORIENTATION.meet}
    target="_blank"
    rel="noopener"
    class="mt-7 flex w-full items-center justify-center gap-3 rounded-2xl border-2 border-cyan-hi bg-cyan px-6 py-5 text-center text-[1.125rem] font-bold leading-tight text-space transition hover:bg-cyan-hi sm:w-auto sm:inline-flex sm:px-10 sm:py-6 sm:text-[1.375rem]"
  >
    Join the guardian orientation on Google Meet <span aria-hidden="true">&rarr;</span>
  </a>
  <p class="mt-3 text-[0.875rem] text-ink-3">
    {when} · <span class="break-all">{ORIENTATION.meet.replace('https://', '')}</span>
  </p>
</section>
