---
import { EVENT, MINORS_NOTICE, LEGAL_MINORS_HREF } from '../data/event';

// Absolute ("/#tracks") so the same nav works from /legal as well as home.
const NAV = [
  { href: '/#tracks', label: 'Tracks' },
  { href: '/#prizes', label: 'Prizes' },
  { href: '/#participate', label: 'Participate' },
  { href: '/#sponsor', label: 'Sponsors' },
  { href: '/legal', label: 'Legal' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!--
  Minors notice. Sits above the sticky header (not inside it) so it is the first
  thing on every page, mobile and desktop, without permanently eating sticky
  height once the visitor scrolls. A real link, never auto-dismissed.
-->
<div id="minors-notice" class="relative z-30 border-b border-gold/30 bg-space-2">
  <a
    href={LEGAL_MINORS_HREF}
    class="block px-4 py-2.5 text-center text-[0.8125rem] leading-snug font-medium text-ink underline decoration-gold/50 underline-offset-4 transition hover:text-gold hover:decoration-gold sm:px-8 sm:text-[0.875rem]"
  >
    <span aria-hidden="true" class="mr-1.5 text-gold">&#9888;</span>{MINORS_NOTICE}
  </a>
</div>

<!--
  Page-level sticky header.

  Deliberately NOT inside the hero <section>: a sticky element is only sticky
  within its own scroll container, so while this lived in the hero it stopped
  sticking the moment you scrolled past it.

  It condenses on scroll rather than staying full height — at 100svh on a phone,
  a permanent full-size lockup plus the partner credit would eat ~13% of the
  viewport on every section of the page.
-->
<header id="site-header" data-compact="false" class="sticky top-0 z-30">
  <div class="hdr-inner px-4 sm:px-8 lg:px-12">
    <div class="hdr-top">
    <div class="hdr-logos">
      <img
        src="/brand/riverhacks.webp"
        alt="RiverHacks"
        width="600"
        height="180"
        fetchpriority="high"
        decoding="async"
        class="hdr-logo"
      />
      <img
        src="/brand/bracket.webp"
        alt=""
        aria-hidden="true"
        width="220"
        height="99"
        decoding="async"
        class="hdr-bracket"
      />
      <img
        src="/brand/spaceapps.webp"
        alt="NASA International Space Apps Challenge"
        width="680"
        height="298"
        fetchpriority="high"
        decoding="async"
        class="hdr-logo"
      />
    </div>

    <nav aria-label="Main" class="hdr-nav hdr-nav-lg">
      <ul>
        {
          NAV.map((n) => (
            <li>
              <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    </div>

    <p class="hdr-partner">
      <span>
        Powered by{' '}
        <a
          href={EVENT.titlePartner.url}
          target="_blank"
          rel="noopener"
          class="font-semibold text-ink-2 underline decoration-white/25 underline-offset-4 transition hover:text-cyan hover:decoration-cyan"
          >{EVENT.titlePartner.name}</a
        >
      </span>
      <span aria-hidden="true" class="hdr-dot">·</span>
      <span class="hdr-blurb">{EVENT.titlePartner.blurb}</span>
    </p>

    <!-- Same nav for phones and tablets, as one short line under the credit. -->
    <nav aria-label="Main" class="hdr-nav hdr-nav-sm">
      <ul>
        {
          NAV.map((n) => (
            <li>
              <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  #site-header {
    /* Transparent at rest so the 3D scene reads straight through it; gains a
       scrim only once content is scrolling underneath. */
    background: transparent;
    transition:
      background-color 260ms ease,
      backdrop-filter 260ms ease,
      border-color 260ms ease;
    border-bottom: 1px solid transparent;
  }

  #site-header[data-compact='true'] {
    background: color-mix(in oklab, var(--color-space) 82%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom-color: color-mix(in oklab, var(--color-cyan) 14%, transparent);
  }

  .hdr-inner {
    padding-block: 0.85rem;
    transition: padding-block 260ms ease;
  }
  #site-header[data-compact='true'] .hdr-inner {
    padding-block: 0.55rem;
  }

  /*
    Mobile: space-between so the lockup spans edge to edge — the marks are
    sized to the largest height that still fits 390px with 16px gutters.
    Desktop: normal left-aligned flow.
  */
  .hdr-logos {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-width: 0;
  }

  /*
    Height scales with viewport width below the sm breakpoint. The three marks
    plus gaps come to roughly 6.5x the logo height, so a fixed 52px (tuned for
    390px) overflowed a 360px phone by 37px. 13vw keeps the row edge-to-edge
    from 320px up without ever exceeding the available width.
  */
  .hdr-logo {
    height: clamp(2.4rem, 13vw, 3.25rem);
    width: auto;
    transition: height 260ms ease;
  }
  .hdr-bracket {
    height: clamp(0.9rem, 4.6vw, 1.25rem);
    width: auto;
    opacity: 0.9;
    flex-shrink: 0;
    transition: height 260ms ease;
  }

  #site-header[data-compact='true'] .hdr-logo {
    height: 2.1rem;
  }
  #site-header[data-compact='true'] .hdr-bracket {
    height: 0.85rem;
  }

  .hdr-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .hdr-top > .hdr-logos {
    flex: 1 1 auto;
  }

  .hdr-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hdr-nav a {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 100, 'wght' 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    color: var(--color-ink-2);
    text-decoration: none;
    padding-block: 0.35rem;
    display: inline-block;
    transition: color 160ms ease;
  }
  .hdr-nav a:hover,
  .hdr-nav a[aria-current='page'] {
    color: var(--color-cyan);
  }
  .hdr-nav-lg {
    display: none;
  }
  .hdr-nav-sm {
    margin-top: 0.35rem;
  }
  .hdr-nav-sm ul {
    flex-wrap: nowrap;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .hdr-nav-sm a {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }
  @media (min-width: 640px) {
    .hdr-nav-sm ul {
      justify-content: flex-start;
      gap: 1.25rem;
    }
    .hdr-nav-sm a {
      font-size: 0.75rem;
      letter-spacing: 0.14em;
    }
  }
  #site-header[data-compact='true'] .hdr-nav-sm {
    display: none;
  }

  .hdr-partner {
    margin: 0.6rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    transition:
      margin 260ms ease,
      opacity 200ms ease;
  }
  .hdr-dot {
    display: none;
    color: color-mix(in oklab, var(--color-ink-3) 60%, transparent);
  }

  /* Compact on a phone drops the blurb and keeps just the attribution, so the
     sticky bar stays one short line. */
  #site-header[data-compact='true'] .hdr-partner {
    margin-top: 0.35rem;
  }
  #site-header[data-compact='true'] .hdr-blurb {
    display: none;
  }

  @media (min-width: 640px) {
    .hdr-logos {
      justify-content: flex-start;
      gap: 1.15rem;
    }
    .hdr-logo {
      height: 3.75rem;
    }
    .hdr-bracket {
      height: 1.35rem;
    }
    #site-header[data-compact='true'] .hdr-logo {
      height: 2.5rem;
    }
    #site-header[data-compact='true'] .hdr-bracket {
      height: 0.95rem;
    }
    .hdr-partner {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
    }
    .hdr-dot {
      display: inline;
    }
    #site-header[data-compact='true'] .hdr-blurb {
      display: inline;
    }
  }

  @media (min-width: 1024px) {
    .hdr-top > .hdr-logos {
      flex: 0 1 auto;
    }
    .hdr-nav-lg {
      display: block;
    }
    .hdr-nav-sm {
      display: none;
    }
    .hdr-logo {
      height: 4.75rem;
    }
    #site-header[data-compact='true'] .hdr-logo {
      height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header,
    .hdr-inner,
    .hdr-logo,
    .hdr-bracket,
    .hdr-partner {
      transition: none;
    }
  }
</style>

<script>
  // Condense once the page has scrolled past a small threshold. Plain passive
  // scroll listener rather than IntersectionObserver so it also reflects
  // Lenis-driven scrolling on desktop, which moves native scrollTop.
  const header = document.getElementById('site-header');

  if (header) {
    let ticking = false;
    const apply = () => {
      header.dataset.compact = String(window.scrollY > 24);
      ticking = false;
    };
    apply();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      },
      { passive: true },
    );
  }
</script>
