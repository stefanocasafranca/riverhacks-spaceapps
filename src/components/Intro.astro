---
import { EVENT } from '../data/event';
---

<section data-chapter="ascent" class="relative px-5 py-24 sm:px-8 sm:py-32 lg:px-12">
  <div class="scrim-text mx-auto max-w-4xl">
    <p class="eyebrow mb-6 text-cyan">The next frontier</p>
    <p
      class="text-[clamp(1.25rem,5.2vw,2.15rem)] leading-[1.32] font-medium text-balance text-ink"
    >
      {EVENT.intro}
    </p>
  </div>
</section>
