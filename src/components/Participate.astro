---
import Section from './Section.astro';
import { STEPS, TIMELINE, REGISTER_URL } from '../data/event';
---

<Section
  chapter="transit"
  id="participate"
  eyebrow="Three steps"
  title="How to<br />participate"
  wide
>
  <div class="grid gap-5 lg:grid-cols-[1fr_0.85fr]">
    <ol class="panel space-y-0 divide-y divide-white/8 rounded-3xl p-6 sm:p-8">
      {
        STEPS.map((s) => (
          <li class="flex gap-4 py-5 first:pt-0 last:pb-0">
            <span
              aria-hidden="true"
              class="display grid h-8 w-8 shrink-0 place-items-center rounded-full border border-cyan/40 text-sm text-cyan"
            >
              {s.n}
            </span>
            <p class="pt-1 text-[0.95rem] leading-relaxed text-ink-2 sm:text-base">
              {s.text}
              {s.link && (
                <>
                  {' '}
                  <a
                    href={s.link.href}
                    target="_blank"
                    rel="noopener"
                    class="font-medium text-cyan underline decoration-cyan/40 underline-offset-4 transition hover:decoration-cyan"
                  >
                    {s.link.label}
                  </a>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ol>

    <!-- Milestone rail -->
    <div class="panel rounded-3xl p-6 sm:p-8">
      <h3 class="eyebrow text-ink-3">Between now and launch</h3>
      <ol class="mt-6 space-y-0">
        {
          TIMELINE.map((t, i) => (
            <li class="relative flex gap-4 pb-6 last:pb-0">
              {i < TIMELINE.length - 1 && (
                <span
                  aria-hidden="true"
                  class="absolute top-3 left-[5px] h-full w-px bg-gradient-to-b from-white/25 to-white/5"
                />
              )}
              <span
                aria-hidden="true"
                class:list={[
                  'relative mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full',
                  t.done ? 'bg-cyan' : 'bg-white/25 ring-1 ring-white/20',
                ]}
              />
              <div class="min-w-0">
                <p
                  class:list={[
                    'display text-[0.95rem]',
                    t.done ? 'text-cyan' : 'text-ink',
                  ]}
                >
                  {t.date}
                </p>
                <p class="mt-0.5 text-[0.8125rem] leading-snug text-ink-3">{t.label}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div class="mt-8 text-center">
    <a
      href={REGISTER_URL}
      target="_blank"
      rel="noopener"
      class="group inline-flex items-center justify-center gap-2 rounded-full bg-cyan px-8 py-4 text-base font-semibold text-space transition hover:bg-cyan-hi sm:text-[1.0625rem]"
    >
      Apply for a seat
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"
        >&rarr;</span
      >
    </a>
    <p class="mt-3 text-[0.8125rem] text-ink-3">200 seats · applications reviewed · free to enter</p>
  </div>
</Section>
