---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Tracks from '../components/Tracks.astro';
import Prizes from '../components/Prizes.astro';
import Participate from '../components/Participate.astro';
import Sponsors from '../components/Sponsors.astro';
import Venue from '../components/Venue.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';
---

<Base>
  <SiteHeader />

  <main id="main">
    <Hero />
    <Intro />
    <Tracks />
    <Prizes />
    <Participate />
    <Sponsors />
    <Venue />
  </main>
  <Footer />
  <StickyCTA />
</Base>
