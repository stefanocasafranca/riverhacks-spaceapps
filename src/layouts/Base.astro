---
import '../styles/global.css';
import { EVENT, SEO, REGISTER_URL } from '../data/event';

// Preloaded so the hero headline — the LCP element — paints in Archivo rather
// than swapping from the fallback a beat later. Same asset the @font-face in
// global.css resolves to, so Vite emits one hashed file, not two.
import Preloader from '../components/Preloader.astro';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  // false on text pages (e.g. /legal): no launch preloader, no three.js scene,
  // just the CSS starfield so the page reads instantly.
  scene?: boolean;
  title?: string;
  description?: string;
}
const { scene = true, title = SEO.title, description = SEO.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;

// Structured data so the event surfaces properly when the link is shared or
// indexed — this page is going to live mostly as a pasted URL.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'RiverHacks 2026 — NASA Space Apps Challenge Austin',
  description: SEO.description,
  startDate: EVENT.dates.iso.start,
  endDate: EVENT.dates.iso.end,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'Place',
    name: EVENT.venue.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: EVENT.venue.street,
      addressLocality: 'Austin',
      addressRegion: 'TX',
      postalCode: '78701',
      addressCountry: 'US',
    },
  },
  organizer: { '@type': 'Organization', name: 'RiverHacks', url: canonical },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/SoldOut',
    url: REGISTER_URL,
    validFrom: '2026-08-26T00:00:00-05:00',
  },
  image: [ogImage],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#000b24" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {scene && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-cyan focus:px-4 focus:py-2 focus:font-semibold focus:text-space"
      >Skip to content</a
    >

    <!--
      Fallback ground. Rendered for everyone; the WebGL boot script hides it only
      once three.js has produced a real frame, so a failed or skipped 3D load
      leaves a finished-looking starfield rather than a black rectangle.
    -->
    {scene && <Preloader />}

    <div id="css-stars" aria-hidden="true"></div>

    {scene && <canvas id="space-canvas" aria-hidden="true" data-ready="false"></canvas>}

    <div id="page">
      <slot />
    </div>

    {
      scene && (
        <script>
          import '../three/boot';
        </script>
      )
    }
  </body>
</html>
